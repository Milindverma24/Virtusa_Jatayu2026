# Sanjeevani Lekh environment. Copy to .env and fill in. .env is git-ignored.

# auto    = online requests use Groq (when GROQ_API_KEY is set), falling back to local on failure
# offline = never contact the cloud
PROCESSING_MODE=auto

# Online mode: Groq (https://console.groq.com/keys)
GROQ_API_KEY=
GROQ_LLM_MODEL=openai/gpt-oss-120b
GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# Offline mode: local Ollama (blank uses the default)
OLLAMA_BASE_URL=http://127.0.0.1:11434
LLM_MODEL=qwen3:8b
LLM_TEMPERATURE=0.0
LLM_NUM_CTX=4096
LLM_KEEP_ALIVE=30m
LLM_SEED=42

# Server
HOST=127.0.0.1
PORT=8000

# Cloud sync to the supervisor dashboard (optional)
SUPABASE_URL=
SUPABASE_KEY=
